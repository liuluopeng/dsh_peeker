{
  "name": "lx_dsh_peek",
  "version": "0.3.0",
  "description": "Read-only, light-themed LAN peek at active DSH sessions: live reasoning, tool and background-command output, animated running state, 1/2/3/4 panes, orientation-aware layout, and a three-flash completion cue.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "remote",
    "peek",
    "read-only"
  ],
  "author": "llp",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "scripts": {
    "check": "node --check src/index.js",
    "test": "node --test tests/server.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
